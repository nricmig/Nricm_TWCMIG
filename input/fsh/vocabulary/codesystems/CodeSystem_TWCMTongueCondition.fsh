* ^property[0].code = #semanticTag
* ^property[0].uri = "https://www.nricm.edu.tw/twcm/CodeSystem/twcm-tonguecondition#semanticTag"
* ^property[0].description = "SNOMED CT 語意類別（semantic tag）"
* ^property[0].type = #string


